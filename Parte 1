	      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_6, 0);  // LED 1
	      HAL_GPIO_WritePin(GPIOC, GPIO_PIN_7, 0);  // LED 2
	      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_9, 0);  // LED 3
	      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_8, 0);  // LED 4

