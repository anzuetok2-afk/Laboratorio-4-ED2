	      else if (contador == 2)
	      {
	          HAL_GPIO_WritePin(GPIOC, GPIO_PIN_7, 1);
	      }
	      else if (contador == 3)
	      {
	          HAL_GPIO_WritePin(GPIOA, GPIO_PIN_9, 1);
	      }
	      else if (contador == 4)
